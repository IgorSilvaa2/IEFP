    <?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#EEEEEE">

    <TextView
        android:id="@+id/textoExemplo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Olá, Bem-Vindo!"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@android:color/holo_red_dark"
        />

    <TextView
        android:id="@+id/textoExemplo2"
        android:layout_width="205dp"
        android:layout_height="65dp"
        android:layout_margin="80"
        android:text="Esta e seu cartão de visita digital!"
        android:textAlignment="center"
        android:textColor="@android:color/holo_green_dark"
        android:textSize="25sp"
        android:textStyle="bold" />


<TextView
    android:id="@+id/title1"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Aqui fica os seus dados !"
    android:textSize="20sp"
    android:textStyle="bold"
    android:textColor="#000000" />

    <TextView
        android:id="@+id/turmaAluno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome : Igor Silva"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingTop="60dp"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/escolaAluno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome da escola: IEFP"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>